{
	"name": "frontend",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev:sso": "VITE_PROJECT=sso vite --config vite.config.ts",
		"dev:portal": "VITE_PROJECT=portal vite --config vite.config.ts",
		"build:sso": "VITE_PROJECT=sso vite build --config vite.config.ts",
		"build:portal": "VITE_PROJECT=portal vite build --config vite.config.ts",
		"build": "pnpm run build:sso && pnpm run build:portal",
		"preview:sso": "VITE_PROJECT=sso vite preview --config vite.config.ts",
		"preview:portal": "VITE_PROJECT=portal vite preview --config vite.config.ts",
		"lint": "eslint packages/*/src/**/*.{ts,tsx,css}"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@typescript-eslint/eslint-plugin": "^8.8.0",
		"@typescript-eslint/parser": "^8.8.0",
		"@vitejs/plugin-react": "^4.3.1",
		"autoprefixer": "^10.4.20",
		"eslint": "^9.12.0",
		"eslint-plugin-css": "^0.11.0",
		"eslint-plugin-react": "^7.37.1",
		"eslint-plugin-react-hooks": "^4.6.2",
		"postcss": "^8.4.47",
		"tailwindcss": "^3.4.13",
		"typescript": "^5.5.4",
		"vite": "^5.4.1"
	},
	"dependencies": {
		"react": "^19.1.1",
		"react-dom": "^19.1.1"
	}
}
